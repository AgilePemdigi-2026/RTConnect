# Salin menjadi backend/.env lalu isi nilainya. JANGAN commit file .env.
APP_ENV=development

# Supabase > tombol "Connect" > Session pooler > URI (ganti [YOUR-PASSWORD]).
# Karakter khusus di password harus di-encode, mis. @ -> %40.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_TIMEZONE=Asia/Jakarta
DB_POOL_MAX=5

# Rahasia acak panjang untuk menandatangani token login aplikasi.
JWT_SECRET=
# Hash bcrypt PIN TTD; dibuat otomatis oleh setup_supabase.py (PIN 123456) bila kosong.
RT_SIGNING_PIN_HASH=

# Supabase > Storage > S3 Connection (buat access key di sana).
STORAGE_BACKEND=s3
S3_BUCKET=rtconnect-files
S3_REGION=<region>
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SEED_DEMO_USERS=true
RT_WHATSAPP_NUMBER=6281234567890

# Identitas wilayah & pengurus di Surat Pengantar / Keterangan
RT_PERUMAHAN=Griya Taman Asri
RT_KELURAHAN=Tawangsari
RT_KECAMATAN=Taman
RT_KABUPATEN=Kabupaten Sidoarjo
RT_SIGNING_LOCATION=Sidoarjo
RT_CHAIR_NAME=Ahmad Dhafin
RW_CHAIR_NAME=Alfarisy
